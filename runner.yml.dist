drupal:
  root: "build"
  base_url: "http://web:8080/build"
  site:
    name: "OpenEuropa"
    profile: "minimal"
  database:
    host: "mysql"
    port: "3306"
    name: "drupal"
    user: "root"
    password: ""
  post_install:
    # Prepare the instance.
    - { task: "exec", command: "./vendor/bin/drush en toolbar -y" }
    - { task: "exec", command: "./vendor/bin/drush theme:enable olivero -y" }
    - { task: "exec", command: "./vendor/bin/drush theme:enable claro -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.theme default olivero -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.theme admin claro -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set node.settings use_admin_theme 1 -y" }
    # Enable the modules.
    - { task: "exec", command: "./vendor/bin/drush en oe_multilingual -y" }
    - { task: "exec", command: "./vendor/bin/drush en oe_multilingual_demo -y" }
    - { task: "exec", command: "./vendor/bin/drush en oe_translation -y" }
    - { task: "exec", command: "./vendor/bin/drush en oe_translation_local -y" }
    - { task: "exec", command: "./vendor/bin/drush cr" }
  additional_settings: |
      $settings['file_scan_ignore_directories'] = array('vendor', 'build');
      $settings['file_private_path'] = 'sites/default/files/private';

      $settings["epoetry.service_url"] = "${drupal.base_url}/epoetry-mock/server";
      $settings["epoetry.application_name"] = getenv('EPOETRY_APPLICATION_NAME');
      $settings["epoetry.auth.cert_service_url"] = getenv('EPOETRY_AUTH_CERT_SERVICE_URL');
      $settings["epoetry.auth.cert_path"] = getenv('EPOETRY_AUTH_CERT_PATH');
      $settings["epoetry.auth.cert_password"] = getenv('EPOETRY_AUTH_CERT_PASSWORD');
      $settings["epoetry.auth.eulogin_base_path"] = getenv('EPOETRY_AUTH_EU_LOGIN_BASEPATH');
      $settings["epoetry.ticket_validation.eulogin_base_path"] = getenv('EPOETRY_TICKET_VALIDATION_EU_LOGIN_BASEPATH');
      $settings["epoetry.ticket_validation.eulogin_job_account"] = getenv('EPOETRY_TICKET_VALIDATION_JOB_ACCOUNT');
      $settings["epoetry.ticket_validation.callback_url"] = getenv('EPOETRY_TICKET_VALIDATION_CALLBACK_URL');
      $settings["epoetry.ticket_validation.on"] = getenv('EPOETRY_TICKET_VALIDATION_ON');
      $settings["epoetry.notification.endpoint_prefix"] = getenv('EPOETRY_NOTIFICATION_ENDPOINT_PREFIX');

      $settings["etrans.service_url"] = getenv('ETRANS_SERVICE_URL');
      $settings["etrans.application_name"] = getenv('ETRANS_APPLICATION_NAME');
      $settings["etrans.password"] = getenv('ETRANS_PASSWORD');

      $settings["cdt.token_api_endpoint"] = getenv('CDT_TOKEN_API_ENDPOINT');
      $settings["cdt.main_api_endpoint"] = getenv('CDT_MAIN_API_ENDPOINT');
      $settings["cdt.reference_data_api_endpoint"] = getenv('CDT_REFERENCE_DATA_API_ENDPOINT');
      $settings["cdt.validate_api_endpoint"] = getenv('CDT_VALIDATE_API_ENDPOINT');
      $settings["cdt.requests_api_endpoint"] = getenv('CDT_REQUESTS_API_ENDPOINT');
      $settings["cdt.identifier_api_endpoint"] = getenv('CDT_IDENTIFIER_API_ENDPOINT');
      $settings["cdt.status_api_endpoint"] = getenv('CDT_STATUS_API_ENDPOINT');
      $settings["cdt.username"] = getenv('CDT_USERNAME');
      $settings["cdt.password"] = getenv('CDT_PASSWORD');
      $settings["cdt.client"] = getenv('CDT_CLIENT');

selenium:
  host: "http://selenium"
  port: "4444"
  browser: "chrome"

commands:
  drupal:site-setup:
    - { task: "run", command: "drupal:symlink-project" }
    - { task: "run", command: "drupal:drush-setup" }
    - { task: "run", command: "drupal:settings-setup" }
    - { task: "run", command: "setup:phpunit" }
  setup:phpunit:
    - { task: "process", source: "phpunit.xml.dist", destination: "phpunit.xml" }
    # Generate settings.testing.php, it will be used when running functional tests.
    - { task: "remove", file: "build/sites/default/settings.testing.php" }
    - task: "append"
      file: "build/sites/default/settings.testing.php"
      text: |
        <?php
        $settings["epoetry.service_url"] = "${drupal.base_url}/epoetry-mock/server";
        $settings["epoetry.application_name"] = 'digit';
        $settings["epoetry.auth.cert_service_url"] = '';
        $settings["epoetry.auth.cert_path"] = '';
        $settings["epoetry.auth.cert_password"] = '';
        $settings["epoetry.auth.eulogin_base_path"] = '';
        $settings["epoetry.ticket_validation.eulogin_base_path"] = '';
        $settings["epoetry.ticket_validation.eulogin_job_account"] = '';
        $settings["epoetry.ticket_validation.callback_url"] = '';
        $settings["epoetry.ticket_validation.on"] = '';
        $settings["epoetry.notification.endpoint_prefix"] = '';

        $settings["etrans.service_url"] = 'https://example.com/etranslation/api/askTranslate';
        $settings["etrans.application_name"] = 'dummy-user';
        $settings["etrans.password"] = 'dummy-pass';

        $settings["cdt.token_api_endpoint"] = getenv('CDT_TOKEN_API_ENDPOINT');
        $settings["cdt.main_api_endpoint"] = getenv('CDT_MAIN_API_ENDPOINT');
        $settings["cdt.reference_data_api_endpoint"] = getenv('CDT_REFERENCE_DATA_API_ENDPOINT');
        $settings["cdt.validate_api_endpoint"] = getenv('CDT_VALIDATE_API_ENDPOINT');
        $settings["cdt.requests_api_endpoint"] = getenv('CDT_REQUESTS_API_ENDPOINT');
        $settings["cdt.identifier_api_endpoint"] = getenv('CDT_IDENTIFIER_API_ENDPOINT');
        $settings["cdt.status_api_endpoint"] = getenv('CDT_STATUS_API_ENDPOINT');
        $settings["cdt.username"] = getenv('CDT_USERNAME');
        $settings["cdt.password"] = getenv('CDT_PASSWORD');
        $settings["cdt.client"] = getenv('CDT_CLIENT');
  toolkit:code-review:
    - { task: "exec", command: "./vendor/bin/grumphp run --verbose" }
  toolkit:test-phpunit:
    - { task: "run", command: "toolkit:test-phpunit-batches" }


toolkit:
  build:
    custom-code-folder: '${drupal.root}/modules/custom'
  lint:
    eslint:
      options_yaml: 'no-error-on-unmatched-pattern'
      options_js: 'no-error-on-unmatched-pattern'
  test:
    phpstan:
      config: phpstan.neon.dist
    phpunit:
      execution: parallel
      batches:
        - batch1
        - batch2
        - batch3
  ci:
    PHP:
      - 8.3
    DRUPAL:
      - ~10.6.0
      - ~11.2.0
    PUBLISH: false
    BEHAT: false
    PHPUNIT: true
    SELENIUM: true
    SELENIUM_VERSION: 4.1.3-20220405
    SPARQL: false
